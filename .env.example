# Discord bot token from the Discord Developer Portal (Bot tab)
TOKEN=

# Discord application (bot) client ID
CLIENT_ID=

# Optional: set to a specific Discord server ID for instant slash command updates during setup/testing.
# Leave empty to register commands globally (may take up to 1 hour to propagate).
GUILD_ID=

# Prefix for text commands (default: !)
PREFIX=!

# Discord user ID of the bot owner (always allowed to use the 247 command)
OWNER_ID=

# NodeLink connection settings (host:port without http:// or ws://)
NODELINK_URL=127.0.0.1:2333
NODELINK_PASSWORD=youshallnotpass
NODELINK_SECURE=false

# Default playback volume (0-100)
DEFAULT_VOLUME=50

# Seconds before leaving an empty voice channel or after the queue finishes (non-24/7 guilds only)
IDLE_LEAVE_SECONDS=120

# Optional: playlist URL (YouTube, SoundCloud, or Spotify) to play automatically when a 24/7 queue becomes empty
FALLBACK_PLAYLIST_URL=

# Optional: hex embed accent color (default: #5865F2)
BRAND_COLOR=#5865F2
